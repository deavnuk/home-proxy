# ============================================================================
#  Home Proxy UI — 环境变量
#    cp .env.example .env
#    chmod 600 .env          # 里面有密码
# ============================================================================

# ---- mihomo 控制接口 ----
# mihomo 与 UI 同机：用 host-gateway 访问宿主机
MIHOMO_API=http://host.docker.internal:9090
# 必须与 config.yaml 里的 secret 完全一致
MIHOMO_SECRET=change-me-please

# ---- mihomo 的 home 目录（-d 参数那个目录，里面有 config.yaml）----
# 会以「同路径」挂进容器：宿主机 /opt/mihomo -> 容器 /opt/mihomo
MIHOMO_HOME=/opt/mihomo
# 配置备份存放目录（宿主机路径）
BACKUP_DIR=./backups

# ---- UI 登录（强烈建议修改）----
UI_USER=admin
UI_PASS=change-this-password

# ---- UI 监听端口 ----
UI_PORT=8080

# ---- 只读模式：1 = 禁止从 UI 改配置/切代理/断连接 ----
UI_READ_ONLY=0

# ---- 配置文件属主 UID/GID（容器以该身份运行，才能写配置）----
# 取法： stat -c '%u:%g' /opt/mihomo/config.yaml
PUID=1000
PGID=1000

# ---- 透明代理 nft 表名（状态面板用）----
NFT_TABLE=inet transp
